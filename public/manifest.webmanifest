{
  "name": "ForemanHQ",
  "short_name": "ForemanHQ",
  "description": "Offline-capable field workflow for trades foremen to manage jobs, material lists, quotes, and supplier orders.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#111827",
  "theme_color": "#111827",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
