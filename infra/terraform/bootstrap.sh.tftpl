#!/bin/bash
set -euo pipefail
umask 077
dnf install -y docker unzip python3 awscli-2
systemctl enable --now docker amazon-ssm-agent
install -d -m 0755 /usr/local/lib/docker/cli-plugins
compose_version=v2.39.4
curl --fail --location --retry 3 "https://github.com/docker/compose/releases/download/$compose_version/docker-compose-linux-x86_64" -o /tmp/docker-compose-linux-x86_64
curl --fail --location --retry 3 "https://github.com/docker/compose/releases/download/$compose_version/docker-compose-linux-x86_64.sha256" -o /tmp/docker-compose-linux-x86_64.sha256
(cd /tmp && sha256sum -c docker-compose-linux-x86_64.sha256)
install -m 0755 /tmp/docker-compose-linux-x86_64 /usr/local/lib/docker/cli-plugins/docker-compose

# The EBS attachment is a separate Terraform resource. Wait for that exact
# Nitro volume, never format a guessed device such as the root disk.
serial=$(printf '%s' '${volume_id}' | tr -d '-')
device=''
for attempt in $(seq 1 120); do
  device=$(lsblk -pnro NAME,SERIAL | awk -v serial="$serial" '$2 == serial {print $1; exit}')
  [ -n "$device" ] && break
  sleep 5
done
[ -n "$device" ] || { echo 'Expected data volume did not attach'; exit 1; }
filesystem=$(lsblk -dnro FSTYPE "$device")
if [ -z "$filesystem" ]; then
  # Refuse to format a disk with partitions or a recognizable filesystem.
  [ "$(lsblk -nr "$device" | wc -l)" -eq 1 ] || exit 1
  mkfs.ext4 "$device"
elif [ "$filesystem" != ext4 ]; then
  echo 'Unexpected filesystem on the data volume'; exit 1
fi
install -d -m 0755 /srv/foremanhq /opt/foremanhq/releases /etc/foremanhq /var/lib/foremanhq
uuid=$(blkid -s UUID -o value "$device")
grep -q "UUID=$uuid " /etc/fstab || printf 'UUID=%s /srv/foremanhq ext4 defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
mount /srv/foremanhq
mountpoint -q /srv/foremanhq
install -d -o 1000 -g 1000 -m 0700 /srv/foremanhq/uploads
install -d -m 0700 /srv/foremanhq/caddy
install -d -m 0755 /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/foremanhq-data.conf <<'UNIT'
[Unit]
RequiresMountsFor=/srv/foremanhq
UNIT
cat > /etc/docker/daemon.json <<'JSON'
{"log-driver":"local","log-opts":{"max-size":"10m","max-file":"3"}}
JSON
systemctl daemon-reload
systemctl restart docker
touch /var/lib/foremanhq/bootstrap-ready
