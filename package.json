{
  "name": "kublai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "check": "pnpm typecheck && pnpm lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed-plumbing.ts",
    "db:clear": "tsx scripts/clear.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo --hostname 0.0.0.0 --port 3000",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "healthcheck": "node scripts/check-health.mjs",
    "lint": "node scripts/check-lint.mjs",
    "lint:fix": "eslint src --fix",
    "preview": "./scripts/open-next-with-env.sh opennextjs-cloudflare build && ./scripts/open-next-with-env.sh opennextjs-cloudflare preview",
    "start": "next start",
    "test:e2e": "playwright test",
    "deploy": "./scripts/open-next-with-env.sh opennextjs-cloudflare build && ./scripts/open-next-with-env.sh opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint:strict": "eslint src",
    "test": "vitest run",
    "test:reliability": "tsx --test src/server/rooms/upload-session.node-test.ts src/server/rooms/bounded-cache.node-test.ts scripts/service-worker.node-test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.7",
    "@napi-rs/canvas": "^1.0.8",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-holidays": "^3.37.0",
    "drizzle-orm": "^0.45.1",
    "dxf-parser": "1.1.2",
    "fflate": "0.8.2",
    "html-to-image": "1.11.13",
    "jsts": "2.12.1",
    "lucide-react": "^0.562.0",
    "manifold-3d": "3.5.4",
    "next": "16.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "replicache": "^15.3.0",
    "server-only": "^0.0.1",
    "stripe": "^20.1.2",
    "superjson": "^2.2.6",
    "svix": "^1.84.1",
    "tailwind-merge": "^3.4.0",
    "three": "0.186.1",
    "web-ifc": "0.0.78",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@opennextjs/cloudflare": "^1.19.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "pnpm": "10.11.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.11.1"
}
