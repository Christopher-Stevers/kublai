# Copy this file to .env and fill in fresh rotated credentials.
# Keep this file aligned with src/env.js and any external integrations you use.

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/kublai"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_ONE_TIME_PRICE_ID=""
STRIPE_SUBSCRIPTION_PRICE_ID=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# Optional OAuth and email settings recovered from prior environment shape.
# Add these only if the app still uses them in your deployment.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional Google Images picker for catalogue part photos.
# Used by the in-app image grid; without it, the UI falls back to opening Google Images.
SERPAPI_API_KEY=""

# Mobile / hosted wrapper
CAP_PROD_URL="https://app.yourdomain.com"
CAP_DEV_URL="http://localhost:3000"
CAP_MODE="dev"
